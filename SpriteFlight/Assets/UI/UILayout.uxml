<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Label text="Score: 0 " name="ScoreLabel" style="align-self: center; font-size: 20px; color: rgb(255, 255, 255); -unity-font-style: bold; top: 20px; background-color: rgba(23, 2, 26, 0.4); border-top-width: 4px; border-right-width: 4px; border-bottom-width: 4px; border-left-width: 4px; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-top-left-radius: 14px; border-bottom-left-radius: 14px; border-top-right-radius: 14px; border-bottom-right-radius: 14px;"/>
    <ui:Button text="Restart" name="RestartButton" style="position: absolute; top: 50%; align-self: center; font-size: 20px; -unity-font-style: bold; border-top-width: 7px; border-right-width: 7px; border-bottom-width: 7px; border-left-width: 7px; border-top-left-radius: 13px; border-top-right-radius: 13px; border-bottom-right-radius: 13px; border-bottom-left-radius: 13px; border-left-color: rgb(184, 162, 136); border-right-color: rgb(184, 162, 136); border-top-color: rgb(184, 162, 136); border-bottom-color: rgb(184, 162, 136); background-color: rgb(255, 253, 253);"/>
    <ui:Button text="Main Menu" name="MenuButton" style="position: absolute; top: 72%; align-self: center; font-size: 20px; -unity-font-style: bold; border-top-width: 7px; border-right-width: 7px; border-bottom-width: 7px; border-left-width: 7px; border-top-left-radius: 13px; border-top-right-radius: 13px; border-bottom-right-radius: 13px; border-bottom-left-radius: 13px; border-left-color: rgb(184, 162, 136); border-right-color: rgb(184, 162, 136); border-top-color: rgb(184, 162, 136); border-bottom-color: rgb(184, 162, 136); background-color: rgb(255, 253, 253);"/>
    <ui:Label text="High Score: 0" name="HighScoreLabel" style="align-self: center; font-size: 15px; -unity-font-style: bold; color: rgb(255, 255, 255); background-color: rgba(70, 242, 255, 0.34); border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-width: 4px; border-top-width: 4px; border-right-width: 4px; border-left-width: 4px; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); -unity-text-outline-width: 0; padding-top: 4px; top: 25px; -unity-slice-type: sliced; -unity-slice-scale: 1px;"/>
    <ui:VisualElement name="PauseMenuContainer" style="flex-grow: 1; background-color: rgba(88, 69, 138, 0.58); scale: 1 1.4; flex-direction: column; justify-content: space-between; top: -46px;">
        <ui:Button text="Return" name="ReturnButton" style="align-self: center; top: 85px; font-size: 20px; -unity-font-style: bold; justify-content: flex-start; align-content: flex-start; height: 27px; -unity-text-outline-width: 0; -unity-text-outline-color: rgb(143, 53, 53); -unity-text-generator: standard; background-color: rgb(255, 255, 255); background-size: 100% 100%; border-top-width: 4px; border-right-width: 4px; border-bottom-width: 4px; border-left-width: 4px; border-top-left-radius: 17px; border-top-right-radius: 17px; border-bottom-right-radius: 17px; border-bottom-left-radius: 17px; border-left-color: rgb(184, 162, 136); border-right-color: rgb(184, 162, 136); border-top-color: rgb(184, 162, 136); border-bottom-color: rgb(184, 162, 136);"/>
        <ui:Button text="Restart" name="PauseRestartButton" style="align-self: center; top: -83px; font-size: 20px; -unity-font-style: bold; height: 28px; -unity-text-outline-color: rgb(255, 255, 255); background-color: rgb(255, 255, 255); border-left-width: 4px; border-top-width: 4px; border-right-width: 4px; border-bottom-width: 4px; border-top-left-radius: 17px; border-top-right-radius: 17px; border-bottom-right-radius: 17px; border-bottom-left-radius: 17px; border-left-color: rgb(184, 162, 136); border-right-color: rgb(184, 162, 136); border-top-color: rgb(184, 162, 136); border-bottom-color: rgb(184, 162, 136);"/>
    </ui:VisualElement>
</ui:UXML>
